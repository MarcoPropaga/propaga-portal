{
  "name": "propaga-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:regras": "firebase emulators:exec --only firestore --project demo-propaga-portal 'vitest run --config vitest.regras.config.ts'",
    "build:servidor": "node apps-script/build.mjs",
    "emuladores": "firebase emulators:start --only auth,firestore,hosting --project demo-propaga-portal",
    "publicar": "next build && firebase deploy --only hosting,firestore:rules,firestore:indexes --project propaga-portal"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "15.5.27",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
