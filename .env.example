# Copie para .env.local. A configuração web do Firebase é pública por natureza;
# a proteção real está nas regras do Firestore e no 2FA.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=propaga-portal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=propaga-portal
NEXT_PUBLIC_FIREBASE_APP_ID=
# URL do Web App do Apps Script (servidor do portal). Opcional: sem ela, a fila é processada a cada minuto.
NEXT_PUBLIC_SERVIDOR_URL=
# true para usar os emuladores locais (npm run emuladores)
NEXT_PUBLIC_USAR_EMULADOR=false
