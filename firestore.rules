rules_version = '2';
// Portal Propaga — regras multi-cliente (plano Spark + servidor Apps Script).
// Princípios:
// (1) todo dado de cliente fica sob /clientes/{clienteId};
// (2) pedidos, valores, eventos e usuários são gravados SÓ pelo servidor (Apps Script, credencial de administrador);
// (3) o navegador apenas registra pedidos de ação na /fila, que o servidor valida (src/lib/fluxo.ts) e executa;
// (4) valores só para quem acessa Relatórios; referência interna de preço só no servidor;
// (5) toda leitura de dados exige segundo fator (2FA).
// Claims definidas pelo servidor: papel, clienteId (cliente) ou propaga=true (equipe Propaga).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function doisFatores() { return request.auth.token.firebase.sign_in_second_factor != null; }
    function papel() { return request.auth.token.papel; }
    function equipePropaga() { return request.auth.token.propaga == true; }
    function admin() { return logado() && doisFatores() && equipePropaga() && papel() == 'admin'; }
    function membro(c) {
      return logado() && doisFatores() && (equipePropaga() || request.auth.token.clienteId == c);
    }
    function veRelatorios(c) {
      return membro(c) && papel() in ['financeiro_cliente', 'atendimento', 'financeiro_propaga', 'admin'];
    }

    match /clientes/{c} {
      allow read: if membro(c);
      allow write: if false;

      match /catalogo/{versao} {
        allow read: if membro(c) && !(papel() in ['criativo', 'midia_social']);
        allow write: if false;
      }

      match /solicitacoes/{protocolo} {
        allow read: if membro(c) && (papel() != 'solicitante' || resource.data.solicitanteUid == request.auth.uid);
        allow write: if false;

        match /eventos/{id} {
          allow read: if membro(c) && (papel() != 'solicitante'
            || get(/databases/$(database)/documents/clientes/$(c)/solicitacoes/$(protocolo)).data.solicitanteUid == request.auth.uid);
          allow write: if false;
        }
      }

      // Calendário de publicações nas redes sociais: leitura pela equipe Propaga e pela Débora; escrita só pelo servidor.
      match /calendarios/{mes} {
        allow read: if membro(c) && papel() in ['solicitante', 'atendimento', 'midia_social', 'admin'];
        allow write: if false;
      }

      match /valores/{protocolo} {
        // Solicitante: só os valores dos próprios pedidos (Relatórios dela).
        allow read: if veRelatorios(c) || (membro(c) && papel() == 'solicitante'
          && get(/databases/$(database)/documents/clientes/$(c)/solicitacoes/$(protocolo)).data.solicitanteUid == request.auth.uid);
        allow write: if false;
      }

      match /rascunhos/{uid} {
        allow read, delete: if membro(c) && request.auth.uid == uid;
        allow create, update: if membro(c) && request.auth.uid == uid && request.resource.size() < 200000;
      }
    }

    // Fila de ações: o navegador só cria pedidos de ação; o servidor valida e executa.
    match /fila/{id} {
      function tiposPermitidos() {
        return admin() ? ['convidar', 'reenviarConvite', 'acessos', 'enviar', 'acao', 'peca', 'publicacao', 'relatorioCriativo', 'pagarCriativo', 'tabelaCriativo', 'arquivarRodada']
          : papel() == 'midia_social' ? ['publicacao']
          : papel() == 'criativo' ? ['peca', 'relatorioCriativo', 'tabelaCriativo', 'arquivarRodada']
          : papel() == 'financeiro_propaga' ? ['acao', 'peca', 'pagarCriativo']
          : ['enviar', 'acao', 'peca', 'publicacao'];
      }
      allow create: if logado() && doisFatores()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.tipo in tiposPermitidos()
        && (equipePropaga() || request.resource.data.clienteId == request.auth.token.clienteId)
        && request.resource.data.keys().hasOnly(['tipo', 'uid', 'clienteId', 'dados', 'status', 'criadoEm'])
        && request.resource.size() < 100000;
      allow read: if logado() && (resource.data.uid == request.auth.uid || admin());
      allow update, delete: if false;
    }

    // Tabela de valores dos criativos (criativo/tabela) e serviços acordados (criativo/adicionais): só os criativos e o administrador (Marco, 15/10/2026).
    match /criativo/{doc} {
      allow read: if logado() && doisFatores() && equipePropaga() && papel() in ['criativo', 'admin'];
      allow write: if false;
    }
    // Relatórios mensais da Mariane com os valores dela: ela, o Financeiro da Propaga (Marisa) e o administrador.
    // Id = <uid do criativo>_<AAAA-MM>: cada criativo lê só os seus (decisão de 15/10/2026: vários criativos).
    match /relatoriosCriativo/{id} {
      allow read: if logado() && doisFatores() && equipePropaga() && (
        papel() in ['financeiro_propaga', 'admin'] || (papel() == 'criativo' && id.matches(request.auth.uid + '_.*')));
      allow write: if false;
    }
    // Lista dos criativos ativos (uid e nome, sem valores), para o Marcelo escolher no aceite.
    match /equipe/{doc} {
      allow read: if logado() && doisFatores() && equipePropaga();
      allow write: if false;
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || admin());
      allow write: if false;
    }

    match /interno/{doc=**} {
      allow read, write: if false; // só o servidor
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
